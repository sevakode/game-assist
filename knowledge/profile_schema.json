{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "resource_scalars",
            "hp_pickups",
            "mana_pickups",
            "inventory",
            "quests",
            "bosses",
            "missables"
          ],
          "title": "Capability",
          "type": "string"
        },
        "status": {
          "enum": [
            "unknown",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "game_version": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Game Version"
        },
        "save_format_version": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Save Format Version"
        },
        "parser_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Id"
        },
        "parser_revision": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Revision"
        },
        "scalar_fields": {
          "items": {
            "enum": [
              "healthUpgradeFragmentCount",
              "manaUpgradeFragmentCount",
              "currentHealth",
              "currentMana"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Scalar Fields",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reviewer": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "required": [
        "capability",
        "status"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_review",
            "synthetic_test",
            "private_fixture_report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "summary": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "reference",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GameProfile": {
      "additionalProperties": false,
      "properties": {
        "appid": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Appid",
          "type": "integer"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "registry_status": {
          "default": "draft",
          "enum": [
            "draft",
            "approved"
          ],
          "title": "Registry Status",
          "type": "string"
        },
        "registry_reviewer": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registry Reviewer"
        },
        "parser_auto_enable": {
          "const": false,
          "default": false,
          "title": "Parser Auto Enable",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "rights": {
          "$ref": "#/$defs/Rights"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/Coverage"
          },
          "maxItems": 100,
          "title": "Coverage",
          "type": "array"
        }
      },
      "required": [
        "appid",
        "title",
        "sources",
        "rights"
      ],
      "title": "GameProfile",
      "type": "object"
    },
    "Rights": {
      "additionalProperties": false,
      "properties": {
        "contributor": {
          "minLength": 1,
          "title": "Contributor",
          "type": "string"
        },
        "basis": {
          "enum": [
            "original",
            "authorized"
          ],
          "title": "Basis",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "permission_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission Reference"
        }
      },
      "required": [
        "contributor",
        "basis",
        "license"
      ],
      "title": "Rights",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "attribution"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/GameProfile"
      },
      "maxItems": 1000,
      "title": "Profiles",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "profiles"
  ],
  "title": "ProfileRegistry",
  "type": "object"
}
