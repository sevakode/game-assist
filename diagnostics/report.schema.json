{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Assist diagnostic report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_version",
    "python_version",
    "platform",
    "component",
    "stage",
    "reason",
    "request_id",
    "http_status",
    "installation",
    "service",
    "pairing",
    "venv_available"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "app_version": {
      "type": "string",
      "pattern": "^(?:unknown|[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})(?![\\s\\S])",
      "maxLength": 11
    },
    "python_version": {
      "type": "string",
      "pattern": "^(?:unknown|[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})(?![\\s\\S])",
      "maxLength": 11
    },
    "platform": {
      "type": "string",
      "enum": [
        "linux",
        "windows",
        "macos",
        "unknown"
      ]
    },
    "component": {
      "type": "string",
      "enum": [
        "server",
        "web",
        "deck"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "install",
        "service",
        "pairing",
        "authorization",
        "request",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "none",
        "unknown",
        "install_interrupted",
        "install_partial",
        "unit_mismatch",
        "working_directory_unavailable",
        "venv_unavailable",
        "service_failed",
        "pairing_pending",
        "pairing_expired",
        "pairing_denied",
        "consent_required",
        "network_unavailable",
        "upstream_timeout",
        "upstream_unavailable",
        "origin_denied",
        "csrf_denied",
        "unauthenticated",
        "rate_limited",
        "invalid_request",
        "not_found",
        "internal_error",
        "request_cancelled"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])",
      "maxLength": 32
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "installation": {
      "type": "string",
      "enum": [
        "unknown",
        "missing",
        "interrupted",
        "partial",
        "unit_mismatch",
        "present",
        "unsafe_or_unreadable"
      ]
    },
    "service": {
      "type": "string",
      "enum": [
        "unknown",
        "active",
        "inactive",
        "failed",
        "activating",
        "deactivating",
        "unavailable"
      ]
    },
    "pairing": {
      "type": "string",
      "enum": [
        "unknown",
        "missing",
        "pending",
        "expired",
        "denied",
        "locally_valid_remote_not_checked"
      ]
    },
    "venv_available": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
